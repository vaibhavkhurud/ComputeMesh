{
  "name": "computemesh",
  "version": "0.1.0",
  "private": true,
  "description": "ComputeMesh — Peer-to-peer distributed compute marketplace",
  "scripts": {
    "dev": "pnpm --filter './apps/*' --parallel run dev",
    "build": "pnpm --filter './packages/*' run build && pnpm --filter './apps/*' run build",
    "test": "pnpm -r run test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,json,md,css}\"",
    "db:migrate": "pnpm --filter @computemesh/database run migrate",
    "db:migrate:dev": "pnpm --filter @computemesh/database run migrate:dev",
    "db:generate": "pnpm --filter @computemesh/database run generate",
    "db:studio": "pnpm --filter @computemesh/database run studio",
    "clean": "pnpm -r run clean && rimraf node_modules"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "eslint": "^9.15.0",
    "typescript-eslint": "^8.15.0",
    "typescript": "^5.6.0",
    "prettier": "^3.4.0",
    "rimraf": "^6.0.0"
  },
  "packageManager": "pnpm@9.15.4"
}
