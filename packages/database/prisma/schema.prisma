generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// System info table to verify migration infrastructure works.
model SystemInfo {
  id        Int      @id @default(autoincrement())
  key       String   @unique @db.VarChar(255)
  value     String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_info")
}

enum UserRole {
  CUSTOMER
  PROVIDER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

model User {
  id            String     @id @default(uuid())
  email         String     @unique
  passwordHash  String
  role          UserRole   @default(CUSTOMER)
  status        UserStatus @default(ACTIVE)
  emailVerified Boolean    @default(false)
  lastLoginAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  
  sessions      Session[]
  provider      Provider?
  jobs          Job[]

  @@map("users")
}

model Session {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  familyId    String
  expiresAt   DateTime
  revokedAt   DateTime?
  lastUsedAt  DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("sessions")
}

enum ProviderStatus {
  REGISTERED
  ACTIVE
  SUSPENDED
  DISABLED
}

model Provider {
  id          String         @id @default(uuid())
  userId      String         @unique
  user        User           @relation(fields: [userId], references: [id])
  status      ProviderStatus @default(REGISTERED)
  displayName String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  machines    Machine[]
  assignments JobAssignment[]

  @@map("providers")
}

enum MachineStatus {
  REGISTERED
  AVAILABLE
  BUSY
  OFFLINE
  DRAINING
  DISABLED
}

model Machine {
  id              String           @id @default(uuid())
  providerId      String
  provider        Provider         @relation(fields: [providerId], references: [id])
  name            String
  status          MachineStatus    @default(REGISTERED)
  hostname        String
  operatingSystem String
  architecture    String
  region          String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  
  resource        MachineResource?
  enrollmentToken EnrollmentToken?
  agentIdentity   AgentIdentity?
  discovery       MachineDiscovery?
  assignments     JobAssignment[]
  leases          ExecutionLease[]

  @@index([providerId])
  @@index([status])
  @@map("machines")
}

model MachineResource {
  id          String   @id @default(uuid())
  machineId   String   @unique
  machine     Machine  @relation(fields: [machineId], references: [id], onDelete: Cascade)
  cpuCores    Int
  memoryMb    Int
  storageGb   Int
  gpuCount    Int      @default(0)
  gpuModel    String?
  gpuMemoryMb Int?
  cudaVersion String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("machine_resources")
}

model EnrollmentToken {
  id         String   @id @default(uuid())
  machineId  String   @unique
  machine    Machine  @relation(fields: [machineId], references: [id])
  tokenHash  String   @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime @default(now())

  @@map("enrollment_tokens")
}

enum AgentStatus {
  ACTIVE
  REVOKED
}

model AgentIdentity {
  id              String      @id @default(uuid())
  machineId       String      @unique
  machine         Machine     @relation(fields: [machineId], references: [id])
  credentialHash  String
  status          AgentStatus @default(ACTIVE)
  agentVersion    String?
  lastHeartbeatAt DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@map("agent_identities")
}

enum DiscoveryStatus {
  SUCCESS
  PARTIAL
  FAILED
  UNAVAILABLE
}

model MachineDiscovery {
  id                 String           @id @default(uuid())
  machineId          String           @unique
  machine            Machine          @relation(fields: [machineId], references: [id])
  cpuLogicalCores    Int?
  cpuArchitecture    String?
  memoryMb           Int?
  operatingSystem    String?
  gpuCount           Int?             
  gpuModel           String?
  gpuMemoryMb        Int?
  cudaVersion        String?
  discoveryStatus    DiscoveryStatus  @default(SUCCESS)
  discoveryError     String?          
  gpuDiscoveryStatus DiscoveryStatus  @default(SUCCESS) 
  discoveredAt       DateTime         @default(now())
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@map("machine_discoveries")
}

enum JobStatus {
  CREATED
  QUEUED
  SCHEDULING
  ASSIGNED
  LEASED
  STARTING
  RUNNING
  CHECKPOINTING
  INTERRUPTED
  COMPLETED
  FAILED
  CANCELLED
}

model Job {
  id          String         @id @default(uuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id])
  name        String
  status      JobStatus      @default(CREATED)
  checkpointSequence Int       @default(0)
  recoveryAttempts Int       @default(0)
  
  inputBucket String?
  inputKey    String?
  inputSize   BigInt?        @db.BigInt
  
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  queuedAt    DateTime?
  cancelledAt DateTime?
  completedAt DateTime?
  
  requirement JobRequirement?
  events      JobEvent[]
  assignments JobAssignment[]
  leases      ExecutionLease[]
  checkpoints Checkpoint[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([userId, status, createdAt])
  @@map("jobs")
}

model JobRequirement {
  id              String   @id @default(uuid())
  jobId           String   @unique
  job             Job      @relation(fields: [jobId], references: [id])
  cpuCoresMin     Int?
  memoryMbMin     Int?
  gpuRequired     Boolean  @default(false)
  gpuCount        Int?
  gpuModel        String?
  gpuMemoryMbMin  Int?
  cudaVersion     String?
  architecture    String?
  operatingSystem String?
  region          String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("job_requirements")
}

enum EventActorType {
  USER
  SYSTEM
  AGENT
  ADMIN
}

model JobEvent {
  id          String         @id @default(uuid())
  jobId       String
  job         Job            @relation(fields: [jobId], references: [id])
  eventType   String
  fromStatus  JobStatus?
  toStatus    JobStatus
  actorType   EventActorType
  actorId     String
  metadata    Json?
  createdAt   DateTime       @default(now())

  @@index([jobId, createdAt])
  @@map("job_events")
}

enum AssignmentStatus {
  PENDING
  ACTIVE
  RELEASED
  REJECTED
}

model JobAssignment {
  id               String           @id @default(uuid())
  jobId            String
  job              Job              @relation(fields: [jobId], references: [id])
  machineId        String
  machine          Machine          @relation(fields: [machineId], references: [id])
  providerId       String
  provider         Provider         @relation(fields: [providerId], references: [id])
  status           AssignmentStatus @default(ACTIVE)
  assignedAt       DateTime         @default(now())
  releasedAt       DateTime?
  failureReason    String?
  schedulerScore   Float?
  outputBucket     String?
  outputKey        String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  
  lease            ExecutionLease?
  checkpoints      Checkpoint[]

  @@index([jobId, status])
  @@index([machineId, status])
  @@map("job_assignments")
}

enum LeaseStatus {
  ACTIVE
  EXPIRED
  REVOKED
  CLOSED
}

model ExecutionLease {
  id              String        @id @default(uuid())
  jobId           String
  assignmentId    String        @unique
  machineId       String
  
  issuedAt        DateTime      @default(now())
  expiresAt       DateTime
  lastRenewedAt   DateTime      @default(now())
  
  status          LeaseStatus   @default(ACTIVE)
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  
  job             Job           @relation(fields: [jobId], references: [id], onDelete: Restrict)
  assignment      JobAssignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  machine         Machine       @relation(fields: [machineId], references: [id], onDelete: Restrict)
  checkpoints     Checkpoint[]

  @@index([jobId])
  @@index([expiresAt])
  @@map("execution_leases")
}

enum CheckpointStatus {
  CREATING
  UPLOADED
  VERIFYING
  VERIFIED
  FAILED
  DELETED
}

model Checkpoint {
  id                String           @id @default(uuid())
  jobId             String
  assignmentId      String
  executionLeaseId  String
  sequence          Int
  status            CheckpointStatus
  bucket            String
  storageKey        String
  sizeBytes         BigInt
  checksumSha256    String
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  verifiedAt        DateTime?
  metadata          Json?
  failureReason     String?

  job               Job              @relation(fields: [jobId], references: [id])
  assignment        JobAssignment    @relation(fields: [assignmentId], references: [id])
  executionLease    ExecutionLease   @relation(fields: [executionLeaseId], references: [id])

  @@unique([jobId, sequence])
  @@index([jobId, status, sequence(sort: Desc)])
  @@index([assignmentId])
  @@index([executionLeaseId])
  @@map("checkpoints")
}


