generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "windows"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// System info table to verify migration infrastructure works.
model SystemInfo {
  id        Int      @id @default(autoincrement())
  key       String   @unique @db.VarChar(255)
  value     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_info")
}

model User {
  id            String     @id @default(uuid())
  email         String     @unique
  passwordHash  String
  role          UserRole   @default(CUSTOMER)
  status        UserStatus @default(ACTIVE)
  emailVerified Boolean    @default(false)
  lastLoginAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  jobs          Job[]
  provider      Provider?
  sessions      Session[]
  wallet        Wallet?

  @@map("users")
}

model Session {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime  @default(now())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  familyId   String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Provider {
  id          String          @id @default(uuid())
  userId      String          @unique
  status      ProviderStatus  @default(REGISTERED)
  displayName String
  stripeAccountId     String?         @unique
  stripeAccountStatus StripeAccountStatus @default(PENDING)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  description String?
  website     String?
  assignments JobAssignment[]
  machines    Machine[]
  user        User            @relation(fields: [userId], references: [id])

  @@map("providers")
}

model Machine {
  id                String            @id @default(uuid())
  providerId        String
  name              String
  status            MachineStatus     @default(REGISTERED)
  hostname          String
  operatingSystem   String
  architecture      String
  region            String
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  marketplaceStatus MarketplaceStatus @default(UNLISTED)
  agentIdentity     AgentIdentity?
  enrollmentToken   EnrollmentToken?
  leases            ExecutionLease[]
  assignments       JobAssignment[]
  discovery         MachineDiscovery?
  pricing           MachinePricing?
  resource          MachineResource?
  provider          Provider          @relation(fields: [providerId], references: [id])

  @@index([providerId])
  @@index([status])
  @@index([marketplaceStatus, status])
  @@map("machines")
}

model MachinePricing {
  id                   String   @id @default(uuid())
  machineId            String   @unique
  flatCentsPerHour     Int      @default(0)
  cpuCentsPerHour      Int      @default(0)
  memoryGbCentsPerHour Int      @default(0)
  gpuCentsPerHour      Int      @default(0)
  currency             String   @default("USD")
  minBillingMinutes    Int      @default(60)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  machine              Machine  @relation(fields: [machineId], references: [id], onDelete: Cascade)

  @@map("machine_pricing")
}

model MachineResource {
  id          String   @id @default(uuid())
  machineId   String   @unique
  cpuCores    Int
  memoryMb    Int
  storageGb   Int
  gpuCount    Int      @default(0)
  gpuModel    String?
  gpuMemoryMb Int?
  cudaVersion String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  machine     Machine  @relation(fields: [machineId], references: [id], onDelete: Cascade)

  @@map("machine_resources")
}

model EnrollmentToken {
  id        String    @id @default(uuid())
  machineId String    @unique
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  machine   Machine   @relation(fields: [machineId], references: [id])

  @@map("enrollment_tokens")
}

model AgentIdentity {
  id              String      @id @default(uuid())
  machineId       String      @unique
  credentialHash  String
  status          AgentStatus @default(ACTIVE)
  agentVersion    String?
  lastHeartbeatAt DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  machine         Machine     @relation(fields: [machineId], references: [id])

  @@map("agent_identities")
}

model MachineDiscovery {
  id                 String          @id @default(uuid())
  machineId          String          @unique
  cpuLogicalCores    Int?
  cpuArchitecture    String?
  memoryMb           Int?
  operatingSystem    String?
  gpuCount           Int?
  gpuModel           String?
  gpuMemoryMb        Int?
  cudaVersion        String?
  discoveryStatus    DiscoveryStatus @default(SUCCESS)
  discoveryError     String?
  gpuDiscoveryStatus DiscoveryStatus @default(SUCCESS)
  discoveredAt       DateTime        @default(now())
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  machine            Machine         @relation(fields: [machineId], references: [id])

  @@map("machine_discoveries")
}

model Job {
  id                      String           @id @default(uuid())
  userId                  String
  name                    String
  status                  JobStatus        @default(CREATED)
  inputBucket             String?
  inputKey                String?
  inputSize               BigInt?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt
  queuedAt                DateTime?
  cancelledAt             DateTime?
  completedAt             DateTime?
  checkpointSequence      Int              @default(0)
  recoveryAttempts        Int              @default(0)
  quotedCurrency          String?
  quotedPriceCentsPerHour Int?
  billingSegments         BillingSegment[]
  checkpoints             Checkpoint[]
  leases                  ExecutionLease[]
  assignments             JobAssignment[]
  events                  JobEvent[]
  requirement             JobRequirement?
  user                    User             @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([userId, status, createdAt])
  @@map("jobs")
}

model JobRequirement {
  id                   String   @id @default(uuid())
  jobId                String   @unique
  cpuCoresMin          Int?
  memoryMbMin          Int?
  gpuRequired          Boolean  @default(false)
  gpuCount             Int?
  gpuModel             String?
  gpuMemoryMbMin       Int?
  cudaVersion          String?
  architecture         String?
  operatingSystem      String?
  region               String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  maxPriceCentsPerHour Int?
  targetMachineId      String?
  job                  Job      @relation(fields: [jobId], references: [id])

  @@map("job_requirements")
}

model JobEvent {
  id         String         @id @default(uuid())
  jobId      String
  eventType  String
  fromStatus JobStatus?
  toStatus   JobStatus
  actorType  EventActorType
  actorId    String
  metadata   Json?
  createdAt  DateTime       @default(now())
  job        Job            @relation(fields: [jobId], references: [id])

  @@index([jobId, createdAt])
  @@map("job_events")
}

model JobAssignment {
  id             String           @id @default(uuid())
  jobId          String
  machineId      String
  providerId     String
  status         AssignmentStatus @default(ACTIVE)
  assignedAt     DateTime         @default(now())
  releasedAt     DateTime?
  failureReason  String?
  schedulerScore Float?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  outputBucket   String?
  outputKey      String?
  billingSegment BillingSegment?
  checkpoints    Checkpoint[]
  lease          ExecutionLease?
  job            Job              @relation(fields: [jobId], references: [id])
  machine        Machine          @relation(fields: [machineId], references: [id])
  provider       Provider         @relation(fields: [providerId], references: [id])

  @@index([jobId, status])
  @@index([machineId, status])
  @@map("job_assignments")
}

model ExecutionLease {
  id            String        @id @default(uuid())
  jobId         String
  assignmentId  String        @unique
  machineId     String
  issuedAt      DateTime      @default(now())
  expiresAt     DateTime
  lastRenewedAt DateTime      @default(now())
  status        LeaseStatus   @default(ACTIVE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  checkpoints   Checkpoint[]
  assignment    JobAssignment @relation(fields: [assignmentId], references: [id])
  job           Job           @relation(fields: [jobId], references: [id])
  machine       Machine       @relation(fields: [machineId], references: [id])

  @@index([jobId])
  @@index([expiresAt])
  @@map("execution_leases")
}

model Checkpoint {
  id               String           @id @default(uuid())
  jobId            String
  assignmentId     String
  executionLeaseId String
  sequence         Int
  status           CheckpointStatus
  bucket           String
  storageKey       String
  sizeBytes        BigInt
  checksumSha256   String
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  verifiedAt       DateTime?
  metadata         Json?
  failureReason    String?
  assignment       JobAssignment    @relation(fields: [assignmentId], references: [id])
  executionLease   ExecutionLease   @relation(fields: [executionLeaseId], references: [id])
  job              Job              @relation(fields: [jobId], references: [id])

  @@unique([jobId, sequence])
  @@index([jobId, status, sequence(sort: Desc)])
  @@index([assignmentId])
  @@index([executionLeaseId])
  @@map("checkpoints")
}

model SecurityEvent {
  id        String            @id @default(uuid())
  type      String
  actorType SecurityActorType
  actorId   String?
  ipAddress String?
  metadata  Json?
  createdAt DateTime          @default(now())

  @@index([type, createdAt])
  @@index([actorId, createdAt])
  @@map("security_events")
}

model Wallet {
  id              String        @id @default(uuid())
  userId          String?       @unique
  type            WalletType
  currency        String        @default("USD")
  balance         BigInt        @default(0)
  reservedBalance BigInt        @default(0)
  version         Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  ledgerEntries   LedgerEntry[]
  user            User?         @relation(fields: [userId], references: [id])

  @@map("wallets")
}

model FinancialTransaction {
  id             String        @id @default(uuid())
  type           TxType
  status         TxStatus
  idempotencyKey String        @unique
  referenceId    String?
  currency       String        @default("USD")
  createdAt      DateTime      @default(now())
  completedAt    DateTime?
  entries        LedgerEntry[]

  @@map("financial_transactions")
}

model LedgerEntry {
  id            String               @id @default(uuid())
  transactionId String
  walletId      String
  type          EntryType
  amount        BigInt
  createdAt     DateTime             @default(now())
  transaction   FinancialTransaction @relation(fields: [transactionId], references: [id])
  wallet        Wallet               @relation(fields: [walletId], references: [id])

  @@index([transactionId])
  @@index([walletId])
  @@map("ledger_entries")
}

model BillingSegment {
  id                   String        @id @default(uuid())
  jobId                String
  assignmentId         String        @unique
  providerWalletId     String
  status               SegmentStatus @default(ACTIVE)
  actualDurationMs     BigInt?
  billableDurationMs   BigInt?
  billedAmount         BigInt?
  providerEarning      BigInt?
  flatCentsPerHour     Int
  cpuCentsPerHour      Int
  memoryGbCentsPerHour Int
  gpuCentsPerHour      Int
  requestedCpuCores    Int
  requestedMemoryGb    Int
  requestedGpuCount    Int
  minBillingMinutes    Int
  startedAt            DateTime      @default(now())
  endedAt              DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  assignment           JobAssignment @relation(fields: [assignmentId], references: [id])
  job                  Job           @relation(fields: [jobId], references: [id])

  @@index([jobId])
  @@map("billing_segments")
}

model Payout {
  id               String       @id @default(uuid())
  walletId         String
  amount           BigInt
  status           PayoutStatus
  idempotencyKey   String       @unique
  stripeTransferId String?      @unique
  stripePayoutId   String?      @unique
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([walletId])
  @@map("payouts")
}

enum UserRole {
  CUSTOMER
  PROVIDER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum ProviderStatus {
  REGISTERED
  ACTIVE
  SUSPENDED
  DISABLED
}

enum MarketplaceStatus {
  UNLISTED
  LISTED
  PAUSED
}

enum MachineStatus {
  REGISTERED
  AVAILABLE
  BUSY
  OFFLINE
  DRAINING
  DISABLED
}

enum AgentStatus {
  ACTIVE
  REVOKED
}

enum DiscoveryStatus {
  SUCCESS
  PARTIAL
  FAILED
  UNAVAILABLE
}

enum JobStatus {
  CREATED
  QUEUED
  SCHEDULING
  ASSIGNED
  LEASED
  STARTING
  RUNNING
  CHECKPOINTING
  INTERRUPTED
  COMPLETED
  FAILED
  CANCELLED
}

enum EventActorType {
  USER
  SYSTEM
  AGENT
  ADMIN
}

enum AssignmentStatus {
  PENDING
  ACTIVE
  RELEASED
  REJECTED
}

enum LeaseStatus {
  ACTIVE
  EXPIRED
  REVOKED
  CLOSED
}

enum CheckpointStatus {
  CREATING
  UPLOADED
  VERIFYING
  VERIFIED
  FAILED
  DELETED
}

enum SecurityActorType {
  USER
  AGENT
  ADMIN
  SYSTEM
  ANONYMOUS
}

enum WalletType {
  CUSTOMER
  PROVIDER
  SYSTEM
}

enum TxType {
  DEPOSIT
  RESERVATION
  SETTLEMENT
  REFUND
  PAYOUT
  PAYOUT_FAILURE
}

enum TxStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
}

enum EntryType {
  DEBIT
  CREDIT
}

enum SegmentStatus {
  ACTIVE
  COMPLETED
  FAILED
}

enum PayoutStatus {
  REQUESTED
  RESERVED
  SUBMITTED
  PAID
  FAILED
  CANCELLED
}


enum PaymentStatus {
  CREATED
  REQUIRES_ACTION
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum PaymentEventStatus {
  PENDING
  PROCESSED
  FAILED
}

enum StripeAccountStatus {
  PENDING
  RESTRICTED
  READY
}

model Payment {
  id                    String        @id @default(uuid())
  userId                String
  walletId              String
  stripePaymentIntentId String?       @unique
  amount                BigInt
  currency              String        @default("USD")
  status                PaymentStatus @default(CREATED)
  idempotencyKey        String        @unique
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([userId])
  @@index([walletId])
  @@map("payments")
}

model PaymentProviderEvent {
  id            String             @id @default(uuid())
  stripeEventId String             @unique
  eventType     String
  status        PaymentEventStatus @default(PENDING)
  attemptCount  Int                @default(0)
  receivedAt    DateTime           @default(now())
  processedAt   DateTime?
  failureReason String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@map("payment_provider_events")
}
