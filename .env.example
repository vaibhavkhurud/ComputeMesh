# ===========================================
# ComputeMesh — Environment Configuration
# ===========================================
# Copy this file to .env and fill in values.
# NEVER commit the .env file.
# ===========================================

# Application
APP_ENV=development
API_PORT=3001
WEB_PORT=3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://computemesh:computemesh_dev@localhost:5432/computemesh?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Object Storage (S3-compatible)
S3_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY=computemesh
S3_SECRET_KEY=computemesh_dev_secret
S3_BUCKET=computemesh-storage

# API
API_BASE_URL=http://localhost:3001

# Security
# Generate a strong secret for production: openssl rand -base64 64
JWT_SECRET=

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000

# JWT Auth
JWT_ACCESS_SECRET=dev-only-jwt-secret-do-not-use-in-production-12345678901234567890
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

JWT_ACCESS_SECRET=your_super_secret_jwt_key_here_minimum_32_chars
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Stripe Configuration (M13-B)
STRIPE_TEST_SECRET_KEY=sk_test_...
STRIPE_TEST_WEBHOOK_SECRET=whsec_...
